    "info": {
        "title": "Sehan Mock Exam API",
        "version": "1.0",
        "description": "An API for mock exams",
        "license": {
            "name": "MIT"
        }
    },
    "tags": [
        {
            "name": "hello",
            "description": "Hello World operations"
        },
        {
            "name": "exams",
            "description": "Exam-related operations"
        },
        {
            "name": "exam-submissions",
            "description": "Exam submission operations"
        },
        {
            "name": "students",
            "description": "Student-related operations"
        },
        {
            "name": "subjects",
            "description": "Subject-related operations"
        },
        {
            "name": "grades",
            "description": "Grade-related operations"
        },
        {
            "name": "Auth",
            "description": "사용자 인증을 위한 API"
        },
        {
            "name": "files",
            "description": "File handling operations"
        },
        {
            "name": "comments",
            "description": "Exam Comments and Scores"
        },
        {
            "name": "teachers",
            "description": "Teacher-related operations"
        }
    ],
    "servers": [
        {
            "url": "/"
        }
    ],
    "components": {
        "responses": {
            "ParseError": {
                "description": "When a mask can't be parsed"
            },
            "MaskError": {
                "description": "When any error occurs on mask"
            }
        },
        "requestBodies": {
            "Student": {
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Student"
                        }
                    }
                },
                "required": true
            },
            "Teacher": {
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Teacher"
                        }
                    }
                },
                "required": true
            },
            "User_Auth": {
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/User_Auth"
                        }
                    }
                },
                "required": true
            },
            "ExamSubmission": {
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/ExamSubmission"
                        }
                    }
                },
                "required": true
            }
        },
        "schemas": {
            "Exam": {
                "required": [
                    "grade",
                    "subject",
                    "title"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "description": "Exam ID",
                        "example": 1
                    },
                    "title": {
                        "type": "string",
                        "description": "Exam name",
                        "example": "Math Exam"
                    },
                    "subject": {
                        "type": "string",
                        "description": "Subject name",
                        "example": "Math"
                    },
                    "grade": {
                        "type": "string",
                        "description": "Grade for the exam",
                        "example": "pre-IB or 11"
                    },
                    "file": {
                        "type": "object",
                        "description": "Exam file",
                        "example": "filename.pdf"
                    },
                    "file_name": {
                        "type": "string",
                        "description": "The file name of the uploaded exam file",
                        "example": "exam_2025.pdf"
                    }
                },
                "type": "object"
            },
            "ExamSubmission": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "description": "Submission ID",
                        "example": 101
                    },
                    "title": {
                        "type": "string",
